# liveTranslate - .env  (copy this file to ".env" and fill it in; never commit .env)
# Keys can also be typed in Settings -> API Keys (stored in Windows Credential Manager).
# Restart the app after changing anything here.

# --- GROQ (translation, primary) ---------------------------------------------
# https://console.groq.com/keys   Use your own account and follow Groq's terms.
# Do not create extra accounts to get around rate limits. Leave the _2.._10
# keys empty unless you have a legitimate reason to use them.
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
GROQ_API_KEY_6=
GROQ_API_KEY_7=
GROQ_API_KEY_8=
GROQ_API_KEY_9=
GROQ_API_KEY_10=
GROQ_MODEL=qwen/qwen3.8-27b

# --- DEEPL (translation, after Groq) -----------------------------------------
# https://www.deepl.com/pro-api  Free plan: 500,000 characters per month.
DEEPL_API_KEY=
